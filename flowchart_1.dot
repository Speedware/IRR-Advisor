digraph G {graph [rankdir=TB,bgcolor="white",nodesep=.28,ranksep=.34];node[shape=box,fontname="DejaVu Sans",fontsize=11,color=black,penwidth=1.2];edge[fontname="DejaVu Sans",fontsize=10,color=black];start[shape=ellipse,label="Начало"];input[label="Ввод ставки, числа проектов (2–3)"];project[label="Ввод проекта: инвестиция, 5–8 потоков"];check[shape=diamond,label="Данные корректны?"];calc[label="Вычисление IRR и NPV"];more[shape=diamond,label="Все проекты введены?"];valid[label="Проверка критериев допуска"];eligible[shape=diamond,label="Есть допустимые проекты?"];best[label="Выбор max NPV; при равенстве — max IRR"];reject[label="Рекомендация: отклонить все"];out[label="Таблица результатов и обоснование"];end[shape=ellipse,label="Конец"];start->input->project->check;check->project[label="нет"];check->calc[label="да"];calc->more;more->project[label="нет"];more->valid[label="да"];valid->eligible;eligible->best[label="да"];eligible->reject[label="нет"];best->out;reject->out;out->end;}