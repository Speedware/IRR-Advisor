digraph G {graph [rankdir=TB,bgcolor="white",nodesep=.26,ranksep=.32];node[shape=box,fontname="DejaVu Sans",fontsize=11,color=black,penwidth=1.2];edge[fontname="DejaVu Sans",fontsize=10,color=black];s[shape=ellipse,label="Начало IRR"];v[label="Проверка последовательности потоков"];pos[shape=diamond,label="Есть положительные потоки?"];bounds[label="Задание нижней и верхней границ"];expand[label="Расширение верхней границы до NPV(b) ≤ 0"];found[shape=diamond,label="Корень ограничен интервалом?"];mid[label="m = (a + b) / 2; вычислить NPV(m)"];stop[shape=diamond,label="Достигнута точность или лимит итераций?"];update[label="Если NPV(m) > 0, a = m; иначе b = m"];returnr[label="Вернуть оценку IRR"];none[label="Вернуть: IRR не определена"];e[shape=ellipse,label="Конец"];s->v->pos;pos->bounds[label="да"];pos->none[label="нет"];bounds->expand->found;found->mid[label="да"];found->none[label="нет"];mid->stop;stop->returnr[label="да"];stop->update[label="нет"];update->mid;returnr->e;none->e;}